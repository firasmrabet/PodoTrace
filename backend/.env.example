# ─────────────────────────────────────────────────────────────────────────────
# PodoTrace — Configuration locale d'exemple (.env.example)
# Copiez ce fichier en `backend/.env` :  cp backend/.env.example backend/.env
# Toutes les variables sont optionnelles en développement.
# ─────────────────────────────────────────────────────────────────────────────

# Identité / environnement
ENV=development          # development | production | test
DEBUG=true
VERSION=1.0.0

# Réseau — le serveur sert l'API *et* l'interface web sur le même port
HOST=0.0.0.0
PORT=8000

# Sécurité (laisser vide en dev pour génération automatique dans .diafoot_secret)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_TTL_MINUTES=15
EXPOSE_OTP_IN_RESPONSE=true
FERNET_KEY=

# Base de données (SQLite par défaut, PostgreSQL en production)
DATABASE_URL=sqlite+aiosqlite:///diafoot.db

# Stockage des images / rapports
STORAGE_DIR=
MAX_UPLOAD_MB=15

# Email OTP (laisser vide pour afficher l'OTP à l'écran en dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM=no-reply@podotrace.health

# Interface web & jeu de démonstration
SERVE_WEB=true
AUTO_SEED_DEMO=true

# IA — Fallback clinique automatique si les poids .pth sont absents
ALLOW_SIMULATION_FALLBACK=true
SEG_CHECKPOINT=fusegnet_effb7_best_model_1.pth
RISK_CHECKPOINT=wound_risk_effb3.pth
MC_DROPOUT_PASSES=4

# OAuth Google Web/Mobile (Client ID public Google Cloud Console)
GOOGLE_CLIENT_ID=

# Assistant IA Médical (Clé API Groq)
GROQ_API_KEY=
