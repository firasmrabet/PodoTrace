# ─────────────────────────────────────────────────────────────────────────────
# PodoTrace — configuration locale.
# Copiez ce fichier en `backend/.env` :  cp backend/.env.example backend/.env
# Toutes les variables sont optionnelles : sans .env, l'application démarre
# en mode développement avec SQLite, stockage local et comptes de démonstration.
# ─────────────────────────────────────────────────────────────────────────────

# Identité / environnement
ENV=development          # development | production | test
DEBUG=true
VERSION=1.0.0

# Réseau — le serveur sert l'API *et* l'interface web sur le même port
HOST=0.0.0.0
PORT=8000

# Sécurité
# En développement, laissez vide : une clé est générée une seule fois dans
# backend/.podotrace_secret (les images chiffrées restent lisibles après redémarrage).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_TTL_MINUTES=15
EXPOSE_OTP_IN_RESPONSE=true   # dev uniquement — false en production
# Clé Fernet (chiffrement au repos des photos). Vide = dérivée de SECRET_KEY.
FERNET_KEY=

# Base de données (SQLite par défaut, PostgreSQL en production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/podotrace
DATABASE_URL=

# Stockage des images / rapports
STORAGE_DIR=
MAX_UPLOAD_MB=15

# CORS (l'interface est servie par le backend : rien à ajouter en local)
# CORS_EXTRA_ORIGINS=https://app.podotrace.tn

# Email OTP (vide = OTP affiché à l'écran en développement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@podotrace.health

# Interface web + jeu de démonstration (3 plaies, 9 analyses, 2 comptes)
SERVE_WEB=true
AUTO_SEED_DEMO=true

# IA — les poids .pth sont optionnels : sans eux, le moteur colorimétrique
# calibré (segmenter-hsv + risk-calibrated) prend le relais automatiquement.
ALLOW_SIMULATION_FALLBACK=true
SEG_CHECKPOINT=wound_seg_unetpp_effb3.pth
RISK_CHECKPOINT=wound_risk_effb3.pth
