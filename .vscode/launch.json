{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DiaFoot Sentinel — API + Web",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "DiaFoot Sentinel — API (sans reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "app/tests",
        "-q"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Script — réamorcer la démo",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.reset_demo",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Navigateur — Chrome sur localhost:8000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "DiaFoot Sentinel — tout lancer",
      "configurations": [
        "DiaFoot Sentinel — API + Web",
        "Navigateur — Chrome sur localhost:8000"
      ],
      "stopAll": true
    }
  ]
}
